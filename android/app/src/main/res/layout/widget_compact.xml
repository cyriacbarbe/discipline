<?xml version="1.0" encoding="utf-8"?>
<!-- Widget sur une ligne : temps, première limite, bouton ▶. Mêmes identifiants que widget.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_fond"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fond" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/widget_haut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_temps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ECEFF4"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_etats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#ECEFF4"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_lancer"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_bouton"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
